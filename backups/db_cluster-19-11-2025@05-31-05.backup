--
-- Name: buscar_hierarquia_time(uuid); Type: FUNCTION; Schema: public; Owner: postgres
--

CREATE FUNCTION public.buscar_hierarquia_time(p_time_id uuid) RETURNS TABLE(time_id uuid, nome character varying, nivel integer, caminho text[])
    LANGUAGE plpgsql
    AS $$
BEGIN
    RETURN QUERY
    WITH RECURSIVE hierarquia AS (
        -- Caso base: time inicial
        SELECT 
            t.id,
            t.nome,
            0 AS nivel,
            ARRAY[t.nome]::TEXT[] AS caminho
        FROM time t
        WHERE t.id = p_time_id
        
        UNION ALL
        
        -- Caso recursivo: times filhos
        SELECT 
            t.id,
            t.nome,
            h.nivel + 1,
            h.caminho || t.nome
        FROM time t
        INNER JOIN hierarquia h ON t.time_pai_id = h.id
        WHERE t.ativo = TRUE
    )
    SELECT 
        h.id,
        h.nome,
        h.nivel,
        h.caminho
    FROM hierarquia h
    ORDER BY h.nivel, h.nome;
END;
$$;


ALTER FUNCTION public.buscar_hierarquia_time(p_time_id uuid) OWNER TO postgres;

--
-- Name: FUNCTION buscar_hierarquia_time(p_time_id uuid); Type: COMMENT; Schema: public; Owner: postgres
--

COMMENT ON FUNCTION public.buscar_hierarquia_time(p_time_id uuid) IS 'Retorna a hierarquia completa (filhos) de um time';


--
-- Name: buscar_pessoas_hierarquia(uuid); Type: FUNCTION; Schema: public; Owner: postgres
--

CREATE FUNCTION public.buscar_pessoas_hierarquia(p_time_id uuid) RETURNS TABLE(pessoa_id uuid, nome character varying, email_corporativo character varying, cargo_nome character varying, time_nome character varying, nivel_hierarquia integer)
    LANGUAGE plpgsql
    AS $$
BEGIN
    RETURN QUERY
    WITH RECURSIVE hierarquia AS (
        -- Caso base: time inicial
        SELECT 
            t.id,
            0 AS nivel
        FROM time t
        WHERE t.id = p_time_id
        
        UNION ALL
        
        -- Caso recursivo: times filhos
        SELECT 
            t.id,
            h.nivel + 1
        FROM time t
        INNER JOIN hierarquia h ON t.time_pai_id = h.id
        WHERE t.ativo = TRUE
    )
    SELECT 
        p.id,
        p.nome,
        p.email_corporativo,
        c.nome,
        t.nome,
        h.nivel
    FROM hierarquia h
    INNER JOIN time t ON t.id = h.id
    INNER JOIN pessoa p ON p.time_id = t.id
    INNER JOIN cargo c ON c.id = p.cargo_id
    WHERE p.ativo = TRUE
    ORDER BY h.nivel, t.nome, p.nome;
END;
$$;


ALTER FUNCTION public.buscar_pessoas_hierarquia(p_time_id uuid) OWNER TO postgres;

--
-- Name: FUNCTION buscar_pessoas_hierarquia(p_time_id uuid); Type: COMMENT; Schema: public; Owner: postgres
--

COMMENT ON FUNCTION public.buscar_pessoas_hierarquia(p_time_id uuid) IS 'Retorna todas as pessoas em uma hierarquia de times';


--
-- Name: calcular_percentual_reajuste(); Type: FUNCTION; Schema: public; Owner: postgres
--

CREATE FUNCTION public.calcular_percentual_reajuste() RETURNS trigger
    LANGUAGE plpgsql
    AS $$
BEGIN
    IF NEW.salario_anterior > 0 THEN
        NEW.percentual = ((NEW.salario_novo - NEW.salario_anterior) / NEW.salario_anterior) * 100;
    END IF;
    RETURN NEW;
END;
$$;


