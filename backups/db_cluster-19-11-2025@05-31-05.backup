COMMENT ON TABLE public.historico_mudanca IS 'Log de auditoria imutável de todas as mudanças no sistema';


--
-- Name: COLUMN historico_mudanca.tipo_entidade; Type: COMMENT; Schema: public; Owner: postgres
--

COMMENT ON COLUMN public.historico_mudanca.tipo_entidade IS 'Nome da tabela/entidade alterada';


--
-- Name: historico_reajuste; Type: TABLE; Schema: public; Owner: postgres
--

CREATE TABLE public.historico_reajuste (
    id uuid DEFAULT extensions.uuid_generate_v4() NOT NULL,
    pessoa_id uuid NOT NULL,
    salario_anterior numeric(15,2) NOT NULL,
    salario_novo numeric(15,2) NOT NULL,
    data_reajuste date NOT NULL,
    motivo text,
    percentual numeric(10,4),
    criado_em timestamp with time zone DEFAULT now() NOT NULL,
    criado_por uuid,
    CONSTRAINT check_salarios_positivos CHECK (((salario_anterior > (0)::numeric) AND (salario_novo > (0)::numeric)))
);


ALTER TABLE public.historico_reajuste OWNER TO postgres;

--
-- Name: TABLE historico_reajuste; Type: COMMENT; Schema: public; Owner: postgres
--

COMMENT ON TABLE public.historico_reajuste IS 'DADO SENSÍVEL LGPD - Histórico de reajustes salariais';


--
-- Name: COLUMN historico_reajuste.percentual; Type: COMMENT; Schema: public; Owner: postgres
--

COMMENT ON COLUMN public.historico_reajuste.percentual IS 'Percentual calculado: (novo - anterior) / anterior * 100';


--
-- Name: historico_time; Type: TABLE; Schema: public; Owner: postgres
--

CREATE TABLE public.historico_time (
    id uuid DEFAULT extensions.uuid_generate_v4() NOT NULL,
    pessoa_id uuid NOT NULL,
    time_id uuid NOT NULL,
    data_inicio date NOT NULL,
    data_fim date,
    criado_em timestamp with time zone DEFAULT now() NOT NULL,
    CONSTRAINT check_periodo_time_valido CHECK (((data_fim IS NULL) OR (data_fim >= data_inicio)))
);


ALTER TABLE public.historico_time OWNER TO postgres;

--
-- Name: TABLE historico_time; Type: COMMENT; Schema: public; Owner: postgres
--

COMMENT ON TABLE public.historico_time IS 'Histórico de alocações de pessoas em times';


--
-- Name: COLUMN historico_time.data_fim; Type: COMMENT; Schema: public; Owner: postgres
--

COMMENT ON COLUMN public.historico_time.data_fim IS 'NULL indica alocação atual';


