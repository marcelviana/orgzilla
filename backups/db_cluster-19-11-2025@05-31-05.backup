--
-- Name: anotacao; Type: ROW SECURITY; Schema: public; Owner: postgres
--

ALTER TABLE public.anotacao ENABLE ROW LEVEL SECURITY;

--
-- Name: anotacao anotacao_admin_insert; Type: POLICY; Schema: public; Owner: postgres
--

CREATE POLICY anotacao_admin_insert ON public.anotacao FOR INSERT WITH CHECK (public.is_admin());


--
-- Name: anotacao anotacao_admin_select; Type: POLICY; Schema: public; Owner: postgres
--

CREATE POLICY anotacao_admin_select ON public.anotacao FOR SELECT USING (public.is_admin());


--
-- Name: anotacao anotacao_creator_delete; Type: POLICY; Schema: public; Owner: postgres
--

CREATE POLICY anotacao_creator_delete ON public.anotacao FOR DELETE USING ((criado_por = public.get_usuario_atual()));


--
-- Name: anotacao anotacao_creator_update; Type: POLICY; Schema: public; Owner: postgres
--

CREATE POLICY anotacao_creator_update ON public.anotacao FOR UPDATE USING ((criado_por = public.get_usuario_atual())) WITH CHECK ((criado_por = public.get_usuario_atual()));


--
-- Name: anotacao anotacao_gestor_insert; Type: POLICY; Schema: public; Owner: postgres
--

CREATE POLICY anotacao_gestor_insert ON public.anotacao FOR INSERT WITH CHECK ((public.is_gestor() AND (((tipo_entidade = 'pessoa'::public.tipo_entidade_anotacao) AND public.pessoa_na_hierarquia_gestor(entidade_id)) OR ((tipo_entidade = 'time'::public.tipo_entidade_anotacao) AND public.time_na_hierarquia_gestor(entidade_id)))));


--
-- Name: anotacao anotacao_gestor_select; Type: POLICY; Schema: public; Owner: postgres
--

CREATE POLICY anotacao_gestor_select ON public.anotacao FOR SELECT USING ((public.is_gestor() AND (((tipo_entidade = 'pessoa'::public.tipo_entidade_anotacao) AND public.pessoa_na_hierarquia_gestor(entidade_id)) OR ((tipo_entidade = 'time'::public.tipo_entidade_anotacao) AND public.time_na_hierarquia_gestor(entidade_id)))));


--
-- Name: cargo; Type: ROW SECURITY; Schema: public; Owner: postgres
--

ALTER TABLE public.cargo ENABLE ROW LEVEL SECURITY;

--
-- Name: cargo cargo_admin_modify; Type: POLICY; Schema: public; Owner: postgres
--

