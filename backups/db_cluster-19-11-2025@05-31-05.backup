--

CREATE POLICY historico_cargo_visualizador_select ON public.historico_cargo FOR SELECT USING ((public.is_visualizador() AND (EXISTS ( SELECT 1
   FROM public.pessoa
  WHERE ((pessoa.id = historico_cargo.pessoa_id) AND (pessoa.ativo = true))))));


--
-- Name: historico_mudanca historico_gestor_select; Type: POLICY; Schema: public; Owner: postgres
--

CREATE POLICY historico_gestor_select ON public.historico_mudanca FOR SELECT USING ((public.is_gestor() AND ((((tipo_entidade)::text = 'pessoa'::text) AND public.pessoa_na_hierarquia_gestor(entidade_id)) OR (((tipo_entidade)::text = 'time'::text) AND public.time_na_hierarquia_gestor(entidade_id)) OR ((tipo_entidade)::text = ANY ((ARRAY['vaga_time'::character varying, 'anotacao'::character varying, 'pessoa_projeto_produto'::character varying, 'pessoa_tag'::character varying])::text[])))));


