-- Name: FUNCTION calcular_percentual_reajuste(); Type: COMMENT; Schema: public; Owner: postgres
--

COMMENT ON FUNCTION public.calcular_percentual_reajuste() IS 'Calcula automaticamente o percentual de reajuste salarial';


--
-- Name: criar_historico_cargo(); Type: FUNCTION; Schema: public; Owner: postgres
--

CREATE FUNCTION public.criar_historico_cargo() RETURNS trigger
    LANGUAGE plpgsql
    AS $$
BEGIN
    IF (TG_OP = 'INSERT') THEN
        -- Primeiro cargo
        INSERT INTO historico_cargo (
            pessoa_id,
            cargo_id,
            data_inicio
        ) VALUES (
            NEW.id,
            NEW.cargo_id,
            NEW.data_inicio_cargo_atual
        );
        
    ELSIF (TG_OP = 'UPDATE' AND OLD.cargo_id != NEW.cargo_id) THEN
        -- Finaliza cargo anterior
        UPDATE historico_cargo
        SET data_fim = NEW.data_inicio_cargo_atual
        WHERE pessoa_id = NEW.id
          AND cargo_id = OLD.cargo_id
          AND data_fim IS NULL;
        
        -- Cria novo cargo
        INSERT INTO historico_cargo (
            pessoa_id,
            cargo_id,
            data_inicio
        ) VALUES (
            NEW.id,
            NEW.cargo_id,
            NEW.data_inicio_cargo_atual
        );
    END IF;
    
    RETURN NEW;
END;
$$;


ALTER FUNCTION public.criar_historico_cargo() OWNER TO postgres;

--
-- Name: FUNCTION criar_historico_cargo(); Type: COMMENT; Schema: public; Owner: postgres
--

COMMENT ON FUNCTION public.criar_historico_cargo() IS 'Gerencia automaticamente o histórico de cargos';


--
-- Name: criar_historico_reajuste(); Type: FUNCTION; Schema: public; Owner: postgres
--

CREATE FUNCTION public.criar_historico_reajuste() RETURNS trigger
    LANGUAGE plpgsql
    AS $$
BEGIN
    -- Só cria histórico se o salário realmente mudou
    IF (TG_OP = 'UPDATE' AND OLD.salario_atual != NEW.salario_atual) THEN
        INSERT INTO historico_reajuste (
            pessoa_id,
            salario_anterior,
            salario_novo,
            data_reajuste,
            motivo,
            criado_por
        ) VALUES (
            NEW.id,
            OLD.salario_atual,
            NEW.salario_atual,
            NEW.data_ultimo_reajuste,
            NEW.motivo_ultimo_reajuste,
            (SELECT id FROM usuario WHERE email = current_user LIMIT 1)
        );
    END IF;
    
    RETURN NEW;
END;
$$;


ALTER FUNCTION public.criar_historico_reajuste() OWNER TO postgres;

--
-- Name: FUNCTION criar_historico_reajuste(); Type: COMMENT; Schema: public; Owner: postgres
--

COMMENT ON FUNCTION public.criar_historico_reajuste() IS 'Cria registro no histórico de reajustes quando salário é alterado';


--
-- Name: criar_historico_time(); Type: FUNCTION; Schema: public; Owner: postgres
--

CREATE FUNCTION public.criar_historico_time() RETURNS trigger
    LANGUAGE plpgsql
    AS $$
BEGIN
    IF (TG_OP = 'INSERT') THEN
        -- Primeira alocação
        INSERT INTO historico_time (
            pessoa_id,
            time_id,
            data_inicio
        ) VALUES (
            NEW.id,
            NEW.time_id,
            NEW.data_entrada
        );
        
    ELSIF (TG_OP = 'UPDATE' AND OLD.time_id != NEW.time_id) THEN
        -- Finaliza alocação anterior
        UPDATE historico_time
        SET data_fim = CURRENT_DATE
        WHERE pessoa_id = NEW.id
          AND time_id = OLD.time_id
          AND data_fim IS NULL;
        
        -- Cria nova alocação
        INSERT INTO historico_time (
            pessoa_id,
            time_id,
            data_inicio
        ) VALUES (
            NEW.id,
            NEW.time_id,
            CURRENT_DATE
        );
    END IF;
    
    RETURN NEW;
END;
$$;


ALTER FUNCTION public.criar_historico_time() OWNER TO postgres;

--
-- Name: FUNCTION criar_historico_time(); Type: COMMENT; Schema: public; Owner: postgres
--

COMMENT ON FUNCTION public.criar_historico_time() IS 'Gerencia automaticamente o histórico de alocações em times';


--
-- Name: finalizar_alocacoes_desligamento(); Type: FUNCTION; Schema: public; Owner: postgres
--

CREATE FUNCTION public.finalizar_alocacoes_desligamento() RETURNS trigger
    LANGUAGE plpgsql
    AS $$
BEGIN
    IF (TG_OP = 'UPDATE' AND NEW.status = 'desligado' AND OLD.status != 'desligado') THEN
        -- Finaliza histórico de time
        UPDATE historico_time
        SET data_fim = NEW.data_desligamento
        WHERE pessoa_id = NEW.id
          AND data_fim IS NULL;
        
        -- Finaliza histórico de cargo
        UPDATE historico_cargo
        SET data_fim = NEW.data_desligamento
        WHERE pessoa_id = NEW.id
          AND data_fim IS NULL;
        
        -- Finaliza alocações em projetos/produtos
        UPDATE pessoa_projeto_produto
        SET data_fim = NEW.data_desligamento,
            ativo = FALSE
        WHERE pessoa_id = NEW.id
          AND data_fim IS NULL;
    END IF;
    
    RETURN NEW;
END;
$$;


ALTER FUNCTION public.finalizar_alocacoes_desligamento() OWNER TO postgres;

--
-- Name: FUNCTION finalizar_alocacoes_desligamento(); Type: COMMENT; Schema: public; Owner: postgres
--

COMMENT ON FUNCTION public.finalizar_alocacoes_desligamento() IS 'Finaliza todas as alocações quando pessoa é desligada';


