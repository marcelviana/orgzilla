COMMENT ON COLUMN public.nivel.ordem IS 'Ordem hierárquica, onde 1 = nível mais baixo';


--
-- Name: pessoa; Type: TABLE; Schema: public; Owner: postgres
--

CREATE TABLE public.pessoa (
    id uuid DEFAULT extensions.uuid_generate_v4() NOT NULL,
    nome character varying(255) NOT NULL,
    nome_social character varying(255),
    email_corporativo character varying(255) NOT NULL,
    email_pessoal character varying(255),
    telefone character varying(50),
    foto_url text,
    cargo_id uuid NOT NULL,
    time_id uuid NOT NULL,
    salario_atual numeric(15,2) NOT NULL,
    data_ultimo_reajuste date NOT NULL,
    motivo_ultimo_reajuste text,
    data_entrada date NOT NULL,
    data_inicio_cargo_atual date NOT NULL,
    data_desligamento date,
    status public.status_pessoa DEFAULT 'ativo'::public.status_pessoa NOT NULL,
    ativo boolean DEFAULT true NOT NULL,
    criado_em timestamp with time zone DEFAULT now() NOT NULL,
    atualizado_em timestamp with time zone DEFAULT now() NOT NULL,
    criado_por uuid,
    CONSTRAINT check_data_inicio_cargo CHECK ((data_inicio_cargo_atual >= data_entrada)),
    CONSTRAINT check_salario_positivo CHECK ((salario_atual > (0)::numeric))
);


ALTER TABLE public.pessoa OWNER TO postgres;

