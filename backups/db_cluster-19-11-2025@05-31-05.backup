--
-- Name: vw_pessoa_completa; Type: VIEW; Schema: public; Owner: postgres
--

CREATE VIEW public.vw_pessoa_completa AS
 SELECT id,
    nome,
    nome_social,
    email_corporativo,
    email_pessoal,
    telefone,
    foto_url,
    cargo_id,
    time_id,
    salario_atual,
    data_ultimo_reajuste,
    motivo_ultimo_reajuste,
    data_entrada,
    data_inicio_cargo_atual,
    data_desligamento,
    status,
    ativo,
    criado_em,
    atualizado_em,
    criado_por
   FROM public.pessoa p
  WHERE (public.is_gestor() AND public.pessoa_na_hierarquia_gestor(id));


ALTER VIEW public.vw_pessoa_completa OWNER TO postgres;

--
-- Name: VIEW vw_pessoa_completa; Type: COMMENT; Schema: public; Owner: postgres
--

COMMENT ON VIEW public.vw_pessoa_completa IS 'View de pessoas com dados sensíveis (apenas para gestores da hierarquia)';


--
-- Name: vw_pessoa_publica; Type: VIEW; Schema: public; Owner: postgres
--

CREATE VIEW public.vw_pessoa_publica AS
 SELECT id,
    nome,
    nome_social,
    email_corporativo,
    email_pessoal,
    telefone,
    foto_url,
    cargo_id,
    time_id,
    data_entrada,
    data_inicio_cargo_atual,
    data_desligamento,
    status,
    ativo,
    criado_em,
    atualizado_em,
    criado_por
   FROM public.pessoa;


ALTER VIEW public.vw_pessoa_publica OWNER TO postgres;

--
-- Name: VIEW vw_pessoa_publica; Type: COMMENT; Schema: public; Owner: postgres
--

COMMENT ON VIEW public.vw_pessoa_publica IS 'View de pessoas sem dados sensíveis (salários)';


