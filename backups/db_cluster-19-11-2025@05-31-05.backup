--
-- Name: pessoa_na_hierarquia_gestor(uuid); Type: FUNCTION; Schema: public; Owner: postgres
--

CREATE FUNCTION public.pessoa_na_hierarquia_gestor(p_pessoa_id uuid) RETURNS boolean
    LANGUAGE plpgsql STABLE SECURITY DEFINER
    AS $$
DECLARE
    v_time_id UUID;
BEGIN
    -- Obtém o time da pessoa
    SELECT time_id INTO v_time_id
    FROM pessoa
    WHERE id = p_pessoa_id;
    
    -- Se não encontrou, retorna false
    IF v_time_id IS NULL THEN
        RETURN FALSE;
    END IF;
    
    -- Verifica se o time da pessoa está na hierarquia do gestor
    RETURN time_na_hierarquia_gestor(v_time_id);
END;
$$;


ALTER FUNCTION public.pessoa_na_hierarquia_gestor(p_pessoa_id uuid) OWNER TO postgres;

