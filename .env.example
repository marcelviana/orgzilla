# Supabase Configuration
# Copie este arquivo para .env.local e preencha com suas credenciais reais
# Obtenha suas credenciais em: https://supabase.com/dashboard/project/_/settings/api

# URL do seu projeto Supabase
# Formato: https://xxxxxxxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_URL=your-project-url

# Chave anônima (anon/public key)
# Esta chave é segura para ser exposta no frontend
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
